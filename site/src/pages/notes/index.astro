---
import Base from '../../layouts/Base.astro';
import { getNotes, formatDate } from '../../notes';

const notes = await getNotes();
---
<Base title="Notes" description="Working notes from the technical books I'm reading.">
  <p class="crumb">~/notes</p>
  <h1>Notes</h1>
  <p>
    Study notes from technical books I'm reading.
  </p>

  <section class="section">
    <h2>Books</h2>
    {
      notes.length > 0 ? (
        <ul class="book-list">
          {notes.map((note) => (
            <li>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
              <p class="meta">
                <span>{note.data.author}</span>
                {note.data.covers && <span>{note.data.covers}</span>}
                <span>updated {formatDate(note.data.updated)}</span>
                {note.data.draft && <span>(draft: hidden in production)</span>}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">None yet.</p>
      )
    }
  </section>
</Base>
